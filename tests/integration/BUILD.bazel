load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# A tiny library so the extractor has a real cc_library compile action to emit,
# plus a header (greeter.h) for it to resolve.
cc_library(
    name = "greeter",
    srcs = ["greeter.cc"],
    hdrs = ["greeter.h"],
)

# The binary just prints the greeting so the bash test below can assert on it.
cc_binary(
    name = "app",
    srcs = ["main.cc"],
    deps = [":greeter"],
)

# A plain cc_test that exercises the library directly (no external test
# framework, to keep this module's dependency surface minimal).
cc_test(
    name = "greeter_test",
    srcs = ["greeter_test.cc"],
    deps = [":greeter"],
)

# Bash-based system test: run the cc_binary and verify it prints the expected
# string. The binary is resolved through Bazel runfiles ($(rlocationpath :app)).
sh_test(
    name = "binary_output_test",
    srcs = ["binary_output_test.sh"],
    args = ["$(rlocationpath :app)"],
    data = [":app"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# `bazel run :refresh` writes compile_commands.json into this module's root,
# following Path 3 in README.md. We list the concrete targets so the extractor
# always sees the library, binary and test compile actions.
refresh_compile_commands(
    name = "refresh",
    targets = [
        "//:greeter",
        "//:app",
        "//:greeter_test",
    ],
)
