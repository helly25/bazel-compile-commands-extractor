load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# A tiny library so the extractor has a real cc_library compile action to emit,
# plus a header (greeter.h) for it to resolve.
cc_library(
    name = "greeter_lib",
    srcs = ["greeter.cc"],
    hdrs = ["greeter.h"],
    # Also linked into the `generator` tool below, so shared.cc gets compiled in
    # both the target and the exec configuration -- the duplicate that
    # --bcce-prefer-target-config collapses.
    deps = [":shared_lib"],
)

cc_library(
    name = "shared_lib",
    srcs = [
        "shared.cc",
        ":generated.cc",
    ],
    hdrs = ["shared.h"],
)

genrule(
    name = "generated_source",
    outs = ["generated.cc"],
    cmd = "echo 'int generated_value() { return 42; }' > $@",
)

# Reachable only through the `generator` tool, hence compiled only in the exec
# configuration. --bcce-prefer-target-config must NOT drop it.
cc_library(
    name = "toolonly_lib",
    srcs = ["toolonly.cc"],
    hdrs = ["toolonly.h"],
)

cc_binary(
    name = "generator",
    srcs = ["generator.cc"],
    deps = [
        ":shared_lib",
        ":toolonly_lib",
    ],
)

# Using `generator` under `tools` is what forces it (and its deps) into the exec
# configuration.
genrule(
    name = "gen_header",
    outs = ["generated.h"],
    cmd = "$(location :generator) > $@",
    tools = [":generator"],
)

cc_library(
    name = "uses_generated",
    srcs = ["uses_generated.cc"],
    hdrs = [
        "uses_generated.h",
        ":gen_header",
    ],
    # Target-configuration user of shared_lib; pairs with the exec-configuration
    # use via :generator above.
    deps = [":shared_lib"],
)

# The binary just prints the greeting so the bash test below can assert on it.
cc_binary(
    name = "greeter",
    srcs = ["greeter_main.cc"],
    deps = [":greeter_lib"],
)

# A plain cc_test that exercises the library directly (no external test
# framework, to keep this module's dependency surface minimal).
cc_test(
    name = "greeter_test",
    srcs = ["greeter_test.cc"],
    deps = [":greeter_lib"],
)

# Bash-based system test: run the cc_binary and verify it prints the expected
# string. The binary is resolved through Bazel runfiles ($(rlocationpath :greeter)).
sh_test(
    name = "binary_output_test",
    srcs = ["binary_output_test.sh"],
    args = ["$(rlocationpath :greeter)"],
    data = [":greeter"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# `bazel run :refresh` writes compile_commands.json into this module's root,
# following Path 3 in README.md. We list the concrete targets so the extractor
# always sees the library, binary and test compile actions.
refresh_compile_commands(
    name = "refresh",
    targets = [
        "//:greeter_lib",
        "//:greeter",
        "//:greeter_test",
        # Drags in the genrule -> generator tool, so the extractor sees
        # exec-configuration compile actions alongside the target-configuration
        # ones. Needed by the --bcce-prefer-target-config coverage.
        "//:uses_generated",
    ],
)

# Same extraction, but with the macro attribute turned off, so
# verify_gitignore_behavior.sh can cover the .bzl plumbing for
# `update_gitignore` and not just the --nobcce-update-gitignore runtime flag.
refresh_compile_commands(
    name = "refresh_no_gitignore",
    targets = ["//:greeter_lib"],
    update_gitignore = False,
)
